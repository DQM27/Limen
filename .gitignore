/target
**/*.rs.bk
.DS_Store
.idea/
.vscode/

# Datos reales del cliente, sólo para desarrollo local (con su autorización).
# NUNCA se suben al repositorio, que es público. Limen usa .surql para su
# esquema, así que ningún .sql legítimo se pierde con esta regla.
datos-privados/
*.sql
*.dump
*.csv

# App móvil: la interfaz y la semilla de datos se generan con preparar.ps1
# y llevan datos reales; nunca se suben.
apps/movil/web/
apps/movil/node_modules/
apps/movil/src-tauri/gen/android/.gradle/
apps/movil/src-tauri/gen/android/app/build/
apps/movil/src-tauri/gen/android/app/src/main/jniLibs/
apps/movil/src-tauri/gen/android/local.properties
*.apk
